<?xml version="1.0" encoding="UTF-8"?>
<!--
  登录后自动启动 MediaPilot 网页服务(npm run dev, 固定 3000 端口)。

  装: sh scripts/install-dev-autostart.sh
  卸: sh scripts/install-dev-autostart.sh uninstall

  - 用登录 shell(zsh -lc)起: 拿到的是你自己的环境, 网页里出片调用本机 claude 时用你自己的登录
    (从 Claude Code 会话里起的服务会带上宿主的代理变量, claude 报 401)。
  - 固定 -p 3000: 3000 被占时直接失败, 不会悄悄换到 3001 跑第二份。
  - 只在登录时起一次, 挂了不自动拉起: 你手动停掉它就是停掉了。
  - 数据库在 Docker 里, 容器设了 restart: unless-stopped, Docker Desktop 开机启动即可。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mediapilot.dev</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__PROJECT_DIR__" || exit 1; exec npm run dev -- -p 3000</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/dev.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/dev.log</string>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
</dict>
</plist>
