    {"do": "click", "role": "button", "name": "/^Clients/", "event": "click:Clients"}, {"do": "wait", "ms": 1000},
    {"do": "click", "text": "示例客户 Sample Co.(模拟数据)", "event": "pick:示例客户"}, {"do": "wait", "ms": 2200}
   ]
  },
