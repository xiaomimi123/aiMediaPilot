   "run": "time pip install 'scrapling[fetchers]==0.5.1'",
   "timeout": 600
  },
  {
   "id": "pit",
   "cwd": "../demos/scrapling",
   "venv": "min",
   "run": "pip install -q scrapling==0.5.1",
   "then": [
    "python -c \"from scrapling.fetchers import Fetcher\""
   ],
   "allowFail": true,
   "timeout": 300
  },
  {
   "id": "spider",
   "cwd": "../demos/scrapling",
   "venv": "fetchers",
   "run": "time python books_spider.py snap_3",
   "outputs": [
    "snap_3.csv"
   ],
   "timeout": 180
  },
  {
   "id": "snap1",
   "cwd": "../demos/scrapling",
   "venv": "fetchers",
   "run": "python books_spider.py snap_1",
   "outputs": [
    "snap_1.csv"
   ],
   "record": false,
   "timeout": 180
  },
  {
   "id": "simcsv",
   "cwd": "../demos/scrapling",
   "run": "python make_sim.py snap_1.csv snap_0_SIMULATED.csv",
   "outputs": [
    "snap_0_SIMULATED.csv"
   ],
   "record": false
  },
  {
   "id": "watch",
   "cwd": "../demos/scrapling",
   "venv": "fetchers",
   "run": "python price_watch.py snap_1.csv snap_3.csv 15"
  },
  {
   "id": "sim",
   "cwd": "../demos/scrapling",
   "venv": "fetchers",
   "run": "python price_watch.py snap_0_SIMULATED.csv snap_3.csv 15"
  }
 ],
