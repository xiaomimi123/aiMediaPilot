{
  "name": "mediapilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "migrate:xhs-stages": "tsx scripts/migrate-xhs-stages.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "tsx src/jobs/workers/index.ts",
    "postinstall": "prisma generate && rebrowser-patches patch --packagePath node_modules/playwright-core || true"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "openai": "^4.73.0",
    "playwright-core": "1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "rebrowser-patches": "^1.0.10",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
