generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 用户与配置 ====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // L1 prediction: 用户上传 onboarding 填的 "通常多少播放";
  // ≥3 条 retro 后会被 retro median 自动覆盖。
  baselinePlays BigInt?

  // Auto-sync (Sub-project D): 最近一次成功 cron tick 的时间戳
  lastAutoSyncAt DateTime?

  aiConfigs                  AIConfig[]
  volcTtsConfig              VolcTtsConfig?
  contentAnalyses            ContentAnalysis[]
  scriptDrafts               ScriptDraft[]
  styleSamples               StyleSample[]
  inspirationVideos          InspirationVideo[]
  inspirationInsights        InspirationInsight[]
  topicIdeas                 TopicIdea[]
  cockpitContents            CockpitContent[]
  videoProductions           VideoProduction[]
  videoTemplates             VideoTemplate[]
  contentAssets              ContentAsset[]
  cockpitInspirations        CockpitInspiration[]
  cockpitStageEvents         CockpitStageEvent[]
  cockpitReviewDays          CockpitReviewDay[]
  cockpitLiveSessions        CockpitLiveSession[]
  cockpitScheduleObjectTypes CockpitScheduleObjectType[]
  cockpitScheduleObjects     CockpitScheduleObject[]
  cockpitGoalCycles          CockpitGoalCycle[]
  cockpitInsightRules        CockpitInsightRule[]
  cockpitPrefs               CockpitPrefs?
  radarKeywords              RadarKeyword[]
  radarItems                 RadarItem[]
  radarRuns                  RadarRun[]
  radarConfig                RadarConfig?
  materials                  Material[]
  hooks                      Hook[]
  teardowns                  Teardown[]
  publishedWorks             PublishedWork[]
}

// Sub-project G: 灵感视频库 — 用户精选爆款 + AI 总结共性
model InspirationVideo {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  platform     String    @default("douyin")
  awemeId      String
  videoUrl     String
  authorName   String?
  title        String
  playCount    BigInt?
  likeCount    BigInt?
  commentCount BigInt?
  shareCount   BigInt?
  collectCount BigInt?
  duration     Int?
  publishedAt  DateTime?
  thumbnailUrl String?
  userNote     String?
  rawData      Json?
  fetchedAt    DateTime  @default(now())

  @@unique([userId, platform, awemeId])
  @@index([userId, fetchedAt])
}

model InspirationInsight {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  videoIds    Json // [InspirationVideo.id, ...]
  output      Json // { titlePatterns, hookTypes, durationStats, recommendedTopics, ... }
  generatedAt DateTime @default(now())

  @@index([userId, generatedAt])
}

model ScriptDraft {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  topic      String
  niche      String
  platform   String    @default("douyin") // 'douyin' | 'xiaohongshu' | 'gongzhonghao'
  output     Json
  picked     Json? // D1: 用户选定要发的版本 (titleIdx / hookIdx / reviewed sections)
  createdAt  DateTime  @default(now())
  archivedAt DateTime? // 放弃的内容移出看板, 不删数据

  // K2: 链到具体被用于哪条 analysis (NULL = 还没拍/还没分析)
  analysisId String?
  analysis   ContentAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  distributions Distribution[]

  @@index([userId, createdAt])
  @@index([analysisId])
}

// 工作台: 选题池 (spec §2.2)
model TopicIdea {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  title         String
  note          String?
  source        String // 'discover' | 'inspiration' | 'manual'
  status        String   @default("POOL") // 'POOL' | 'ADOPTED' | 'DISCARDED'
  scriptDraftId String? // 采纳后链到草稿
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status, createdAt])
}

// 工作台: 分发登记 (spec §2.3)。抖音主阵地发布仍走 ContentAnalysis.douyinUrl,
// 这里管其他平台搬运登记; platform 是代码注册表 key (src/lib/pipeline/platforms.ts), 非 enum。
model Distribution {
  id            String      @id @default(cuid())
  scriptDraftId String
  scriptDraft   ScriptDraft @relation(fields: [scriptDraftId], references: [id], onDelete: Cascade)
  platform      String
  url           String
  publishedAt   DateTime    @default(now())
  note          String?
  createdAt     DateTime    @default(now())

  @@index([scriptDraftId])
}

model AIConfig {
  id        String   @id @default(cuid())
  userId    String
  provider  String // "openai" | "deepseek" | "anthropic" | "zhipu" | "qwen" | "doubao"
  apiKey    String // 加密存储
  modelId   String // 具体模型标识
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
}

model VolcTtsConfig {
  id         String   @id @default(cuid())
  userId     String
  apiKey     String // 加密存储 (src/lib/crypto.ts encrypt()) — 替代原来错误假设的 appId+accessToken
  resourceId String   @default("seed-tts-2.0")
  voiceType  String   @default("zh_female_vv_uranus_bigtts")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId])
}

// ==================== Phase 3 / Direction A: 内容预诊断 ====================

model ContentAnalysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // 视频源 (相对路径,根目录 ./uploads/)
  videoPath        String
  videoFilename    String
  videoSizeBytes   Int
  videoDurationSec Float
  videoMimeType    String

  // 用户输入草稿 (null → AI 生成; 非 null → AI 评价)
  draftTitle     String?
  draftCaption   String?
  draftCoverPath String?

  // 配置
  niche String @default("ai-knowledge")

  // 状态机
  status       ContentAnalysisStatus @default(QUEUED)
  errorMessage String?
  retryCount   Int                   @default(0)

  // 进度 (SSE)
  progress Json?

  // 发前 checklist (Sub-project J): 用户必须 review + 决策才能"可以发了"
  publishChecklist Json?

  // 预处理产物
  framesDir       String?
  hookFramesDir   String? // 钩子专用 6 张帧 (0/0.5/1/1.5/2/2.5s)
  audioPath       String?
  transcriptPath  String?
  coverCandidates Json?

  // AI 结果
  report Json?

  // 成本审计
  llmUsage Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  // ===== Phase 3 / Direction A v2 =====
  douyinUrl         String?
  douyinAwemeId     String?
  publishedAt       DateTime?
  retroStatus       RetroStatus?
  retroErrorMessage String?
  retroReport       Json?
  retroStartedAt    DateTime?
  retroCompletedAt  DateTime?

  actualMetrics ActualMetric[]
  fromScripts   ScriptDraft[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([douyinAwemeId])
  @@index([retroStatus])
}

enum ContentAnalysisStatus {
  QUEUED
  PREPROCESSING
  ANALYZING
  COMPLETED
  FAILED
  CANCELLED
}

enum RetroStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ActualMetric {
  id         String          @id @default(cuid())
  analysisId String
  analysis   ContentAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  snapshotAt       DateTime @default(now())
  daysAfterPublish Float
  source           String   @default("douyin-creator-center")

  plays    BigInt
  likes    BigInt
  comments BigInt
  shares   BigInt
  collects BigInt

  likeRateBp    Int?
  commentRateBp Int?
  shareRateBp   Int?

  completionRateBp   Int?
  retention3sBp      Int?
  followConversionBp Int?

  topComments Json?

  rawReportPath String?

  createdAt DateTime @default(now())

  @@index([analysisId, snapshotAt])
}

// 设计说明：日期字段沿用 cockpit 的 ISO 字符串而非 DateTime——纯函数用字符串比较日期（如 `plannedDate < today`），改类型会破坏零改动原则。
// FollowerSnapshot 不建表：workspace GET 时从 AccountMetric 派生（爬虫已每日写入），PUT 忽略该字段。

model CockpitContent {
  id                   String  @id // 客户端 crypto.randomUUID()
  userId               String
  title                String
  idea                 String  @default("")
  contentType          String  @default("")
  tier                 String  @default("B") // A | B | C
  platform             String  @default("douyin") // 三期 IA 演化: platform 字段 — douyin|xiaohongshu|bilibili|x|youtube|gongzhonghao
  intent               String  @default("") // 十期: 内容意图 — ''|reach|trust|convert
  deliveryMode         String  @default("manual") // manual|ai-faceless，十五期 C
  stage                String  @default("inbox") // inbox|topic|script|recording|editing|publishing|review|archived
  publicationStatus    String  @default("draft") // draft|scheduled|published
  priority             String  @default("normal")
  tags                 Json    @default("[]")
  publishedAt          String  @default("") // cockpit 用 ISO date 字符串, 保持原样
  xhsLink              String  @default("")
  coverCopy            String  @default("")
  publishCopy          String  @default("")
  topic                Json // TopicCard
  script               Json // ScriptDraft 骨架
  recordingNotes       String  @default("")
  editingNotes         String  @default("")
  recordingActProgress Json? // 十四期: 六幕录制/剪辑进度打勾, act key -> 是否完成, 旧行为 null
  editingActProgress   Json?
  metrics              Json // MetricsSnapshot
  review               Json // Review
  scriptScore          Json? // 二十二期: 口播稿评分的**软指标缓存**(CachedSoftScore)。硬指标是纯函数每次现算, 不落库。
  scriptDraftId        String? // → ScriptDraft (AI 稿)
  analysisId           String? // → ContentAnalysis (L1/复盘链)
  createdAt            String
  updatedAt            String
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, stage])
  @@index([userId, platform])
  @@index([scriptDraftId])
  @@index([analysisId])
}

model VideoProduction {
  id              String  @id
  userId          String
  contentId       String
  status          String  @default("queued") // queued|directing|building|assembling|preview_ready|approved|rendering|packaging|done|failed
  mode            String  @default("ppt-narration") // ppt-narration|talking-head-broll|illustration-tts（交付方式，注意与 worker JobData.mode 的 preview/master 是两个不同概念）
  srt             String
  productionRoot  String
  sourceVideoPath String? // talking-head-broll: 用户上传的出镜视频本地路径
  alignedActs     Json? // talking-head-broll/illustration-tts: 对齐阶段产出的真实六幕边界 [{act,startMs,endMs}]
  rawTranscript   Json? // talking-head-broll: ASR 原始 segments(真实原话, 供字幕烧录), illustration-tts 不填
  previewPath     String?
  masterPath      String?
  templateId      String? // 二十期: 由哪个模板发起; null = 内容详情页旧入口, 包装段整段跳过
  /// 二十三期: 逐场景版面 [{ shotId, layout }]。
  /// null = 老行为(全部走顺序挖空), 保证已有任务零迁移。
  sceneLayouts    Json?
  voiceOverride   Json? // 二十期收尾(task-10b): illustration-tts 本次任务的临时配音覆盖 { voiceType?, resourceId? }, 优先级高于模板 voicePreset
  /// 二十三期: 出片后量到的整片静止情况 { frozenSec, totalSec, ratio, ok, segments[], checkedAt, kind }。
  /// null = 这条片子出在这道关接线之前, 界面上如实说「没量过」而不是显示 0 ——
  /// 「没测过」和「测过是 0」是两件完全不同的事, 混起来就是界面在撒谎。
  freezeReport    Json?
  errorMessage    String?
  createdAt       String
  updatedAt       String
  /// 二十五期: 这条任务走哪套渲染层。'legacy' = 旧的 HTML+GSAP 管线(缺省, 老任务零迁移),
  /// 'remotion' = 新链路。**先建后拆**: 两套并存, 验收通过后才删旧的。
  renderer        String  @default("legacy")
  /// 二十五期: Builder 的填槽产出(FilmPlan)。null = 还没跑到 Builder 或走的是旧链路。
  filmPlan        Json?
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, contentId])
}

/// 内容专属的真实素材(二十一期方向 B) —— 截图/表格/长文。
/// 挂在内容而非模板上: 每条片子的素材都不一样, 挂模板会变成每条视频塞同一批图。
model ContentAsset {
  id          String  @id
  userId      String
  contentId   String
  kind        String // image|table|text
  description String // 用户写的一句话说明, Builder 靠它判断该在哪一镜用
  fileName    String? // 图片素材的文件名(相对 assetRoot)
  filePath    String? // 服务端绝对路径
  text        String? // 表格/长文的原始内容
  createdAt   String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, contentId])
}

/// 素材库(v5 阶段 D1) —— 写稿时按幕检索的具体材料。
///
/// 为什么要它: 六幕稿写到需要具体材料的地方, 没有素材 AI 就会开始编 ——
/// 这是当前最大的失真来源。其中 experience(亲身经历)只有本人能录, 书摘和数据
/// AI 自己也查得到, 所以那一类才是账号差异化的唯一来源。
model Material {
  id        String   @id @default(cuid())
  userId    String
  /// quote(书摘) | data(数据) | story(故事) | punchline(金句) | experience(亲身经历)
  kind      String
  content   String   @db.Text
  /// 出处。数据类和书摘类没有出处等于不能用 —— 说错了要掉粉。
  source    String   @default("")
  /// 检索用的关键词, 用户自己填或从 content 里提。
  tags      Json     @default("[]")
  /// 被写进稿子几次 —— 用得多的素材说明这个方向有货。
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([userId, createdAt])
}

/// 钩子库(v5 阶段 D2) —— 前 3 秒的写法。
///
/// 注意这里**没有 predictedRetention 字段**: 发布 0 条时那个数编不出来。排序依据
/// 是纯函数算的结构分。等中回路(发布 → 回采)通了再加 actualRetention。
model Hook {
  id        String   @id @default(cuid())
  userId    String
  text      String   @db.Text
  /// number|question|counter|scene|contrast|other, 存下来是因为用户可以手工改判
  pattern   String
  /// 从哪来: manual(手录) | script(从自己的稿子里抽) | teardown(从拆解里抽)
  origin    String   @default("manual")
  /// 抽自哪份稿子, 用来回跳
  scriptId  String?
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pattern])
  @@index([userId, createdAt])
}

/// 对标视频拆解(v5 阶段 D3)。
///
/// 输入是**口播转写稿**而不是视频文件: 用户实际的工作方式就是先有转写稿再手工拆
/// (Obsidian 里那两份「奥一」「王飞雨」就是), 而当前评分体系的维度正是从那两份里
/// 提炼的 —— 这个板块不是锦上添花, 它是评分标准的来源。
/// 视频上传 → ASR 那条路要新起一条管线, 还没接。
model Teardown {
  id           String   @id @default(cuid())
  userId       String
  title        String
  /// 作者/账号, 可空
  author       String   @default("")
  /// 原始链接, 可空
  url          String   @default("")
  /// 口播转写全文。走视频上传时先是空串, 转写完成后回填。
  transcript   String   @db.Text
  /// 二十三期: 上传的对标视频本地路径。null = 直接贴的转写稿。
  sourceVideoPath String?
  /// AI 拆出来的结构: { formula, segments[], hooks[], takeaways[] }
  result       Json?
  status       String   @default("pending") // pending|transcribing|analyzing|done|failed
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// 已发布作品(v5) —— 从抖音创作者后台回采的真实数据。
///
/// **不是校准样本**: 这些作品不是用本系统写的, 没有预测分可以配对。它们是**基线**:
/// 「这个账号在当前赛道通常什么表现」, 以后新发的片子跟它比。
/// counted 由 shouldCountByDefault 给默认值, 用户可逐条改判 —— 哪些算数直接决定
/// 基线, 不该由一个关键词表替用户拍板。
model PublishedWork {
  id          String   @id @default(cuid())
  userId      String
  platform    String   @default("douyin")
  /// 平台侧的作品 id, 去重与增量更新用
  externalId  String
  title       String   @db.Text
  /// 完整文案(抖音 desc)。分析文案特征要用全文, 截断了就没法判有没有点痛点。
  caption     String   @default("") @db.Text
  /// 话题标签
  hashtags    Json     @default("[]")
  url         String   @default("")
  publishedAt DateTime
  durationSec Int      @default(0)
  /// 隐藏/仅自己可见 —— 101 条里 93 条是隐藏的, 它们 0 播放不是内容问题
  isPrivate   Boolean  @default(false)

  play    Int @default(0)
  digg    Int @default(0)
  comment Int @default(0)
  collect Int @default(0)
  share   Int @default(0)

  /// 是否属于当前赛道(AI 类), 计入分析。默认由关键词判, 用户可逐条改判。
  counted   Boolean  @default(false)
  /// --- 二十三期: 抖音「投稿分析」接口(item_analysis/item_performance)的指标 ---
  /// 注意这一组和上面 play/digg 那一组**来自两个不同的接口, 数字对不上**:
  /// 同一条作品列表接口报 223,960 播, 分析接口报 4,985 播。抖音没说哪个是
  /// 「曝光」哪个是「有效播放」, 所以两组都存、各自标明来源, 页面上并列展示 ——
  /// 挑一个当真相就是在替平台编一个它自己都没给的定义。
  anaPlay            Int?
  /// 5 秒完播率 / 2 秒跳出率 / 条均播放时长(秒), 都是 0~1 的比例或秒数
  completionRate5s   Float?
  bounceRate2s       Float?
  avgPlayDurationSec Float?
  /// 分端播放: { douyin, xigua, yumme }
  playPerClient      Json?
  analyticsFetchedAt DateTime?

  /// 二十三期: 这条作品是用哪份稿子发的 → ScriptDraft。
  /// 校准要的是「预测分 vs 实际表现」的配对, 而回采回来的作品和库里的稿子之间
  /// 原本没有任何对应关系 —— 缺了这个字段, 校准永远接不上, 哪怕你真发了一条
  /// 系统写的稿子。平台不返回这层关系, 只能由人来认领。
  scriptDraftId String?
  /// 最近一次回采时间 —— 数字会随时间涨, 要知道这份快照多旧
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, externalId])
  @@index([userId, publishedAt])
}

model VideoTemplate {
  id              String  @id
  userId          String
  name            String
  description     String  @default("")
  deliveryMode    String // ppt-narration|talking-head-broll|illustration-tts
  /// 成片画幅 '9:16' | '16:9'。空 = 老模板, 按横屏走(零迁移)。
  /// 真人出镜不读它 —— 那条按出镜素材反推, 素材是竖的成片就必须是竖的。
  aspect          String?
  visualStyle     String  @default("card") // card|illustration
  palette         Json?
  voicePreset     Json? // { voiceType?, resourceId? } — 仅 illustration-tts 消费
  scriptPrompt    Json? // { tone?, targetDurationSec?, hookHint?, extraGuidance? }
  captionStyle    Json? // null = 不烧字幕
  bgmPath         String?
  bgmVolume       Float   @default(0.15)
  introPath       String?
  outroPath       String?
  isPreset        Boolean @default(false)
  visualTone      String  @default("dark") // light|dark — 二十一期: 参考视频是米白亮底
  shotPaceSec     Float? // 目标切镜节奏(秒), null = 不约束(老行为)
  showChapterNav  Boolean @default(false) // 顶部常驻六章进度条
  researchEnabled Boolean @default(false) // 写稿前跑 Tavily 素材研究
  builderModel    String  @default("deepseek-chat") // Builder 用哪个模型: 排版吃能力
  /// 二十三期 真人出镜的合成方式: cutaway(顺序挖空, 老行为) | pip(画中画, 人一直在)
  talkingHeadLayout String @default("cutaway")
  /// 二十三期 文字叠加层。**和交付模式正交** —— 图文口播、知识长视频、插画配音
  /// 都能开, 不是某一种模式专属。第一版错做成了第四种交付模式, 用户指出那是
  /// 层级错误: 它只是口播视频的一种形式, 而真人形象将来要能加到任何模式上。
  textOverlayEnabled Boolean @default(false)
  /// 拍摄时人在画面哪一侧 —— 文字安全区靠它算。不做人像识别(要 matting),
  /// 猜错的代价是字直接糊在脸上, 所以由人设定。left|center|right
  personSide        String  @default("right")
  /// 内容源关掉 = 全片只有真人 + 文字(参考片就是这个形态), 不跑 B-roll 生成
  brollEnabled      Boolean @default(true)
  pipPosition       String @default("br") // tl|tr|bl|br
  pipScale          Float  @default(0.25) // 小窗宽度占画面宽度
  pipMargin         Int    @default(40)   // 离边缘像素
  createdAt       String
  updatedAt       String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 抖音账号级「投稿概览」快照(二十三期)。
///
/// 逐条作品的指标挂在 PublishedWork 上, 但账号级的条均值、中位数、封面点击率
/// 是**按时间窗算出来的**, 挂不到任何一条作品上 —— 换个窗口就是另一组数。
/// 所以按窗口存快照, 并保留 fetchedAt: 这些数字会随时间涨, 要知道快照多旧。
model DouyinOverviewSnapshot {
  id                 String   @id @default(cuid())
  userId             String
  /// 统计窗口(平台按 yyyyMMdd 传参, 这里存 ISO date 字符串)
  windowStart        String
  windowEnd          String
  submissionCount    Int      @default(0)
  medianPlay         Int      @default(0)
  avgLike            Int      @default(0)
  avgComment         Int      @default(0)
  avgShare           Int      @default(0)
  avgPlayDurationSec Float    @default(0)
  bounceRate2s       Float    @default(0)
  completionRate5s   Float    @default(0)
  coverClickRate     Float    @default(0)
  /// 平台判定的垂类, 如 ["随拍","旅行","时尚"] —— 和你自己认的赛道可能完全不一样
  verticals          Json     @default("[]")
  fetchedAt          DateTime @default(now())

  @@unique([userId, windowStart, windowEnd])
  @@index([userId, fetchedAt])
}

/// 抖音账号级逐日指标(二十三期)。
///
/// 来源 `/aweme/janus/creator/data/overview/all/`, 11 个指标各带一条 7 天序列。
///
/// **按 (指标, 日期) upsert 而不是存快照**: 接口只回最近 7 天, 但每晚回采一次,
/// 库里就能自己攒出任意长的历史 —— 平台不给的东西, 靠时间攒出来。
model DouyinDailyMetric {
  id     String @id @default(cuid())
  userId String
  /// fans|new_fans|cancel_fans|play|digg|comment|share|profile|account_search|post_search|music_create
  metric String
  /// yyyy-MM-dd
  date   String
  count  Int    @default(0)
  fetchedAt DateTime @default(now())

  @@unique([userId, metric, date])
  @@index([userId, metric])
}

/// 逐日指标的「当前值 / 环比」(二十三期)。
///
/// 单独存是因为**它和日序列对不上**: fans 的当前值是 2765, 而日序列是 395 —— 平台
/// 没有说明这两个数各自的定义。不猜、不换算, 两个都摆出来, 让人自己判断。
model DouyinMetricSummary {
  id             String   @id @default(cuid())
  userId         String
  metric         String
  currentCount   Int      @default(0)
  lastPeriodIncr Int      @default(0)
  fetchedAt      DateTime @default(now())

  @@unique([userId, metric])
}

/// 抖音创作者中心首页的热搜榜(二十三期)。
///
/// 来源 `/aweme/v1/creator/data/overview/billboard`。这是**抖音自己推给创作者的
/// 热点**, 比雷达抓外网准得多 —— 它已经是平台判定的、站内正在热的话题。
///
/// 按 billboardId upsert 并记 firstSeenAt/lastSeenAt/peakHotValue: 一个话题
/// 「热了多久、峰值多高」比「此刻多热」有用得多 —— 刚上榜和快过气的当前热度
/// 可能一样。
model DouyinHotTopic {
  id            String   @id @default(cuid())
  userId        String
  billboardId   String
  title         String
  /// 榜单来源, 如「热搜」
  board         String   @default("")
  hotValue      Int      @default(0)
  peakHotValue  Int      @default(0)
  /// 平台给的关联作品 id, 拆解时可以按图索骥
  relatedItemIds Json    @default("[]")
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  /// 采纳进灵感库之后标记, 避免重复推
  adoptedAt     DateTime?

  @@unique([userId, billboardId])
  @@index([userId, lastSeenAt])
}

model CockpitInspiration {
  id                  String @id
  userId              String
  text                String
  convertedContentIds Json   @default("[]")
  createdAt           String
  updatedAt           String
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CockpitStageEvent {
  id          String @id
  userId      String
  contentId   String
  stage       String
  plannedDate String
  rank        Int
  completedAt String @default("")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, plannedDate])
  @@index([contentId])
}

model CockpitReviewDay {
  id          String @id
  userId      String
  plannedDate String
  note        String @default("")
  createdAt   String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CockpitLiveSession {
