model CockpitInsightRule {
  id              String  @id
  userId          String
  text            String
  sourceContentId String?
  active          Boolean @default(true)
  createdAt       String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CockpitPrefs {
  userId          String   @id
  designStyle     String   @default("editorial")
  navigationOrder Json     @default("[]")
  profile         Json // CreatorProfile
  pageTitles      Json // PageTitles
  stageColors     Json // Record<ContentStage,string>
  contentTypes    Json     @default("[]")
  setupComplete   Boolean  @default(false)
  lastBackupAt    String   @default("")
  updatedAt       DateTime @updatedAt // 冲突检测用, 服务端时间
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 设计说明：这里是服务端域数据（雷达抓取/运行结果），不进 cockpit workspace state，因此不沿用 cockpit 的 ISO 字符串日期约定——
// 时间戳一律用 DateTime，id 由服务端 @default(cuid()) 生成（而非客户端传入）。

model RadarKeyword {
  id        String   @id @default(cuid())
  userId    String
  text      String
  status    String   @default("active") // active|candidate|ignored
  source    String   @default("manual") // manual|ai
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, text])
  @@index([userId, status])
}

model RadarItem {
  id              String    @id @default(cuid())
  userId          String
  url             String
  titleHash       String // 标题指纹, 去重用
  title           String
  sourceSite      String
  publishedAt     DateTime?
  collectedAt     DateTime  @default(now())
  matchedKeywords Json      @default("[]")
  aiSummary       String    @default("")
  aiAngle         String    @default("")
  heatScore       Int       @default(0)
  heatFactors     Json      @default("{}") // 四维 + 共现
  status          String    @default("new") // new|adopted|ignored
  inspirationId   String?
  runId           String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
  @@index([userId, status])
  @@index([userId, heatScore])
}

model RadarRun {
  id           String    @id @default(cuid())
  userId       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  keywordsUsed Json      @default("[]")
  searched     Int       @default(0)
  read         Int       @default(0)
  kept         Int       @default(0)
  errors       Json      @default("[]")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RadarConfig {
  userId             String  @id
  tavilyKeyEncrypted String  @default("") // 复用 AIConfig 的 AES-256-GCM 加密
  dailyLimit         Int     @default(20)
  enabled            Boolean @default(false)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// StyleProfile 是 userId 单行配置，学 RadarConfig 先例：不建 User 反向关系。
// StyleSample 是「定稿即样本」积累路线的沉淀记录，学 ScriptDraft 先例：建 User 关系。

model StyleProfile {
  userId      String   @id
  description String   @default("") // 口吻/句式/口头禅/忌讳
  updatedAt   DateTime @updatedAt
}

model StyleSample {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  platform            String // 本期只有 'douyin'
  content             String // 定稿逐字稿纯文本
  sourceScriptDraftId String? // 溯源
  createdAt           DateTime @default(now())

  @@index([userId, platform, createdAt])
}

// PersonaProfile 是 userId 单行配置，学 StyleProfile/RadarConfig 先例：不建 User 反向关系。

model PersonaProfile {
  userId        String   @id
  audience      String   @default("") // 目标受众
  targetFans    String   @default("") // 想吸引的粉丝画像
  pillars       Json     @default("[]") // PersonaPillar[]
  angle         String   @default("") // 差异化角度
  avoid         String   @default("") // 忌讳
  // 十期: 账号定位体系扩展 — 全部可选, 八期已建档用户新字段为空时行为完全不变
  painPoints    Json     @default("[]") // PersonaPain[]
  offerings     Json     @default("[]") // PersonaOffering[]
  productLogic  String   @default("") // 产品逻辑自述
  marketInsight Json? // PersonaMarketInsight | null
  systemSummary String   @default("") // 定位体系摘要
  updatedAt     DateTime @updatedAt
}

// 十二期: 人物志 —「你是谁」的结构化自述, 与 PersonaProfile(「你做什么生意」) 分表。
// 语言层(口吻/句式/口头禅)不在这里, 完全归 StyleProfile —— 两处都写会让 prompt 自相矛盾。
model CreatorVoice {
  userId      String   @id
  origin      String   @default("") // ≤500 来路故事
  identity    String   @default("") // ≤200 具体身份(非品类标签)
  notIdentity String   @default("") // ≤200 我不是什么 —— 防 AI 写成专家的护栏
  stances     Json     @default("[]") // VoiceStance[] 0-5 条立场主张
  energy      String   @default("") // ≤200 情绪基调
  updatedAt   DateTime @updatedAt
}

// 十二期: 个人经历库 —「你凭什么这么说」, 写稿前按关键词检索, 优先于外部搜索资料。
model CreatorExperience {
  id        String   @id @default(cuid())
  userId    String
  content   String // ≤500 原文(用户随手记的原话, 不改写)
  topic     String   @default("") // ≤20 AI 提炼主题标签
  kind      String   @default("") // '' | practice | failure | insight | result
  keywords  Json     @default("[]") // string[] 3-5 个检索关键词(AI 提取, 可人工编辑)
  usedCount Int      @default(0) // 被写稿命中引用次数
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
