generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 用户与配置 ====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // L1 prediction: 用户上传 onboarding 填的 "通常多少播放";
  // ≥3 条 retro 后会被 retro median 自动覆盖。
  baselinePlays BigInt?

  // Auto-sync (Sub-project D): 最近一次成功 cron tick 的时间戳
  lastAutoSyncAt DateTime?

  aiConfigs                  AIConfig[]
  imageGenConfigs            ImageGenConfig[]
  accounts                   PlatformAccount[]
  contents                   Content[]
  schedules                  PublishTask[]
  competitors                Competitor[]
  contentAnalyses            ContentAnalysis[]
  scriptDrafts               ScriptDraft[]
  styleSamples               StyleSample[]
  inspirationVideos          InspirationVideo[]
  inspirationInsights        InspirationInsight[]
  topicIdeas                 TopicIdea[]
  cockpitContents            CockpitContent[]
  cockpitInspirations        CockpitInspiration[]
  cockpitStageEvents         CockpitStageEvent[]
  cockpitReviewDays          CockpitReviewDay[]
  cockpitLiveSessions        CockpitLiveSession[]
  cockpitScheduleObjectTypes CockpitScheduleObjectType[]
  cockpitScheduleObjects     CockpitScheduleObject[]
  cockpitGoalCycles          CockpitGoalCycle[]
  cockpitInsightRules        CockpitInsightRule[]
  cockpitPrefs               CockpitPrefs?
  radarKeywords              RadarKeyword[]
  radarItems                 RadarItem[]
  radarRuns                  RadarRun[]
  radarConfig                RadarConfig?
}

// Sub-project G: 灵感视频库 — 用户精选爆款 + AI 总结共性
model InspirationVideo {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  platform     String    @default("douyin")
  awemeId      String
  videoUrl     String
  authorName   String?
  title        String
  playCount    BigInt?
  likeCount    BigInt?
  commentCount BigInt?
  shareCount   BigInt?
  collectCount BigInt?
  duration     Int?
  publishedAt  DateTime?
  thumbnailUrl String?
  userNote     String?
  rawData      Json?
  fetchedAt    DateTime  @default(now())

  @@unique([userId, platform, awemeId])
  @@index([userId, fetchedAt])
}

model InspirationInsight {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  videoIds    Json // [InspirationVideo.id, ...]
  output      Json // { titlePatterns, hookTypes, durationStats, recommendedTopics, ... }
  generatedAt DateTime @default(now())

  @@index([userId, generatedAt])
}

model ScriptDraft {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  topic      String
  niche      String
  platform   String    @default("douyin") // 'douyin' | 'xiaohongshu' | 'gongzhonghao'
  output     Json
  picked     Json? // D1: 用户选定要发的版本 (titleIdx / hookIdx / reviewed sections)
  createdAt  DateTime  @default(now())
  archivedAt DateTime? // 放弃的内容移出看板, 不删数据

  // K2: 链到具体被用于哪条 analysis (NULL = 还没拍/还没分析)
  analysisId String?
  analysis   ContentAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  distributions Distribution[]

  @@index([userId, createdAt])
  @@index([analysisId])
}

// 工作台: 选题池 (spec §2.2)
model TopicIdea {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  title         String
  note          String?
  source        String // 'discover' | 'inspiration' | 'manual'
  status        String   @default("POOL") // 'POOL' | 'ADOPTED' | 'DISCARDED'
  scriptDraftId String? // 采纳后链到草稿
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status, createdAt])
}

// 工作台: 分发登记 (spec §2.3)。抖音主阵地发布仍走 ContentAnalysis.douyinUrl,
// 这里管其他平台搬运登记; platform 是代码注册表 key (src/lib/pipeline/platforms.ts), 非 enum。
model Distribution {
  id            String      @id @default(cuid())
  scriptDraftId String
  scriptDraft   ScriptDraft @relation(fields: [scriptDraftId], references: [id], onDelete: Cascade)
  platform      String
  url           String
  publishedAt   DateTime    @default(now())
  note          String?
  createdAt     DateTime    @default(now())

  @@index([scriptDraftId])
}

model AIConfig {
  id        String   @id @default(cuid())
  userId    String
  provider  String // "openai" | "deepseek" | "anthropic" | "zhipu" | "qwen" | "doubao"
  apiKey    String // 加密存储
  modelId   String // 具体模型标识
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
}

model ImageGenConfig {
  id        String        @id @default(cuid())
  userId    String
  provider  ImageProvider
  apiKey    String // 加密存储
  modelId   String // 如 "dall-e-3", "flux-2-pro"
  baseUrl   String? // 自定义 API 地址 (SiliconFlow/Replicate 等)
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
}

enum ImageProvider {
  OPENAI
  REPLICATE
  STABILITY
  MIDJOURNEY
  GOOGLE
  TONGYI_WANX
  ZHIPU_COGVIEW
  JIMENG
  SILICONFLOW
  CUSTOM
}

// ==================== 平台账号 ====================

model PlatformAccount {
  id             String    @id @default(cuid())
  userId         String
  platform       Platform
  platformUid    String
  nickname       String
  avatar         String?
  bio            String?
  profileUrl     String?
  followerCount  Int       @default(0)
  followingCount Int       @default(0)
  noteCount      Int       @default(0)
  likeCount      Int       @default(0)
  isActive       Boolean   @default(true)
  cookieData     Json? // 加密存储登录态
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  metrics        AccountMetric[]
  notes          PlatformNote[]
  syncTasks      SyncTask[]
  publishTargets PublishTarget[]

  proxy       Json?
  syncCron    String?
  loginStatus LoginStatus @default(VALID)

  @@unique([platform, platformUid])
  @@index([userId, platform])
}

enum Platform {
  XIAOHONGSHU
  DOUYIN
  WECHAT_MP
  BILIBILI
  KUAISHOU
  WEIBO
}

enum LoginStatus {
  VALID
  EXPIRED
  NEVER_LOGGED
}

// ==================== 账号指标时序数据 ====================

model AccountMetric {
  id             String   @id @default(cuid())
  accountId      String
  date           DateTime @db.Date
  followerCount  Int
  followingCount Int
  noteCount      Int
  totalLikes     Int
  totalComments  Int
  totalShares    Int
  totalViews     Int
  followerDelta  Int      @default(0)
  createdAt      DateTime @default(now())

  account PlatformAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, date])
  @@index([accountId, date])
}

// ==================== 平台笔记/作品 ====================

model PlatformNote {
  id             String    @id @default(cuid())
  accountId      String
  platformNoteId String
  title          String
  content        String?   @db.Text
  type           NoteType
  coverUrl       String?
  tags           String[]
  publishedAt    DateTime?
  likeCount      Int       @default(0)
  commentCount   Int       @default(0)
  shareCount     Int       @default(0)
  viewCount      Int       @default(0)
  collectCount   Int       @default(0)
  isTop          Boolean   @default(false)
  sourceUrl      String?
  rawData        Json?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account PlatformAccount @relation(fields: [accountId], references: [id])
  metrics NoteMetric[]

  @@unique([accountId, platformNoteId])
  @@index([accountId, publishedAt])
}

enum NoteType {
  IMAGE_TEXT
  VIDEO
  LIVE
}

// ==================== 单篇笔记指标时序 ====================

model NoteMetric {
  id           String   @id @default(cuid())
  noteId       String
  date         DateTime @db.Date
  likeCount    Int
  commentCount Int
  shareCount   Int
  viewCount    Int
  collectCount Int
  createdAt    DateTime @default(now())

  note PlatformNote @relation(fields: [noteId], references: [id])

  @@unique([noteId, date])
  @@index([noteId, date])
}

// ==================== AI 创作内容 ====================

/// @deprecated pivot 前的老通用发布模型。 2026-07 起没有 src/ 代码读写它。
/// 替代者: `ScriptDraft` (脚本生成产物) + `ContentAnalysis` (视频预诊断)。
/// 表和数据保留是为了不丢历史; 新代码不要再写这里。 未来清理时一起 DROP:
/// Content / PublishTask / PublishTarget / Competitor / CompetitorNote。
model Content {
  id          String        @id @default(cuid())
  userId      String
  platform    Platform
  type        ContentType
  title       String?
  body        String        @db.Text
  tags        String[]
  coverPrompt String?
  coverUrl    String?
  aiProvider  String?
  aiModel     String?
  prompt      String?       @db.Text
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  publishTasks PublishTask[]

  @@index([userId, platform, status])
}

enum ContentType {
  NOTE_COPY
  VIDEO_SCRIPT
  TITLE
  TAGS
  COVER_IMAGE
  PUBLISH_PLAN
}

enum ContentStatus {
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

// ==================== 发布任务 (⚠️ deprecated, 见 Content) ====================

/// @deprecated 见 [Content] 注释。 pivot 后不再"一键发布", 用户手动去平台发。
model PublishTask {
  id          String        @id @default(cuid())
  userId      String
  contentId   String
  title       String
  mode        PublishMode   @default(SCHEDULED)
  scheduledAt DateTime?
  status      PublishStatus @default(DRAFT)
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  content Content         @relation(fields: [contentId], references: [id])
  targets PublishTarget[]

  @@index([userId, status])
  @@index([status, scheduledAt])
}

/// @deprecated 见 [Content] 注释。
model PublishTarget {
  id             String              @id @default(cuid())
  publishTaskId  String
  accountId      String
  platform       Platform
  adaptedTitle   String?
  adaptedContent String?             @db.Text
  adaptedTags    String[]
  mediaFiles     Json?
  coverImage     String?
  status         TargetPublishStatus @default(PENDING)
  publishedUrl   String?
  platformNoteId String?
  error          String?
  retryCount     Int                 @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  publishTask PublishTask     @relation(fields: [publishTaskId], references: [id])
  account     PlatformAccount @relation(fields: [accountId], references: [id])

  @@index([publishTaskId])
  @@index([status])
}

enum PublishMode {
  IMMEDIATE
  SCHEDULED
}

enum PublishStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHING
  COMPLETED
  PARTIAL_FAILED
  FAILED
  CANCELLED
}

enum TargetPublishStatus {
  PENDING
  ADAPTING
  READY
  PUBLISHING
  SUCCESS
  FAILED
  CANCELLED
}

// ==================== 竞品账号 (⚠️ deprecated) ====================

/// @deprecated 见 [Content] 注释。 竞品分析目前走 InspirationVideo (用户手挑对标).
model Competitor {
  id             String    @id @default(cuid())
  userId         String
  platform       Platform
  platformUid    String
  nickname       String
  avatar         String?
  followerCount  Int       @default(0)
  noteCount      Int       @default(0)
  analysisResult Json?
  lastAnalyzedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User             @relation(fields: [userId], references: [id])
  notes CompetitorNote[]

  @@unique([userId, platform, platformUid])
}

/// @deprecated 见 [Content] 注释。
model CompetitorNote {
  id             String    @id @default(cuid())
  competitorId   String
  platformNoteId String
  title          String
  type           NoteType
  likeCount      Int       @default(0)
  commentCount   Int       @default(0)
  shareCount     Int       @default(0)
  viewCount      Int       @default(0)
  publishedAt    DateTime?
  tags           String[]
  createdAt      DateTime  @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id])

  @@unique([competitorId, platformNoteId])
}

// ==================== 采集任务 ====================

model SyncTask {
  id         String     @id @default(cuid())
  accountId  String
  type       SyncType
  status     TaskStatus @default(PENDING)
  result     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime   @default(now())

  account PlatformAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, status])
}

enum SyncType {
  PROFILE
  NOTES
  NOTE_DETAIL
  METRICS
  COMPETITOR
}

enum TaskStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

// ==================== 浏览器会话(短生命周期,登录用) ====================

model BrowserSession {
  id          String        @id @default(cuid())
  userId      String
  platform    Platform
  accountId   String?
  status      SessionStatus @default(STARTING)
  cdpUrl      String
  vncPath     String
  containerId String?
  proxyTest   Json?
  qrCode      String?       @db.Text
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
}

enum SessionStatus {
  STARTING
  WAITING_LOGIN
  LOGGED_IN
  SCRAPING
  EXPIRED
  ERROR
}

// ==================== Phase 3 / Direction A: 内容预诊断 ====================

model ContentAnalysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // 视频源 (相对路径,根目录 ./uploads/)
  videoPath        String
  videoFilename    String
  videoSizeBytes   Int
  videoDurationSec Float
  videoMimeType    String

  // 用户输入草稿 (null → AI 生成; 非 null → AI 评价)
  draftTitle     String?
  draftCaption   String?
  draftCoverPath String?

  // 配置
  niche String @default("ai-knowledge")

  // 状态机
  status       ContentAnalysisStatus @default(QUEUED)
  errorMessage String?
  retryCount   Int                   @default(0)

  // 进度 (SSE)
  progress Json?

  // 发前 checklist (Sub-project J): 用户必须 review + 决策才能"可以发了"
  publishChecklist Json?

  // 预处理产物
  framesDir       String?
  hookFramesDir   String? // 钩子专用 6 张帧 (0/0.5/1/1.5/2/2.5s)
  audioPath       String?
  transcriptPath  String?
  coverCandidates Json?

  // AI 结果
  report Json?

  // 成本审计
  llmUsage Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  // ===== Phase 3 / Direction A v2 =====
  douyinUrl         String?
  douyinAwemeId     String?
  publishedAt       DateTime?
  retroStatus       RetroStatus?
  retroErrorMessage String?
  retroReport       Json?
  retroStartedAt    DateTime?
  retroCompletedAt  DateTime?

  actualMetrics ActualMetric[]
  fromScripts   ScriptDraft[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([douyinAwemeId])
  @@index([retroStatus])
}

enum ContentAnalysisStatus {
  QUEUED
  PREPROCESSING
  ANALYZING
  COMPLETED
  FAILED
  CANCELLED
}

enum RetroStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ActualMetric {
  id         String          @id @default(cuid())
  analysisId String
  analysis   ContentAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  snapshotAt       DateTime @default(now())
  daysAfterPublish Float
  source           String   @default("douyin-creator-center")

  plays    BigInt
  likes    BigInt
  comments BigInt
  shares   BigInt
  collects BigInt

  likeRateBp    Int?
  commentRateBp Int?
  shareRateBp   Int?

  completionRateBp   Int?
  retention3sBp      Int?
  followConversionBp Int?

  topComments Json?

  rawReportPath String?

  createdAt DateTime @default(now())

  @@index([analysisId, snapshotAt])
}

// ============ Creator Cockpit (2026-08-04 整体移植, spec: docs/superpowers/specs/2026-08-04-cockpit-adoption-design.md) ============
// 设计说明：日期字段沿用 cockpit 的 ISO 字符串而非 DateTime——纯函数用字符串比较日期（如 `plannedDate < today`），改类型会破坏零改动原则。
// FollowerSnapshot 不建表：workspace GET 时从 AccountMetric 派生（爬虫已每日写入），PUT 忽略该字段。

model CockpitContent {
  id                String  @id // 客户端 crypto.randomUUID()
  userId            String
  title             String
  idea              String  @default("")
  contentType       String  @default("")
  tier              String  @default("B") // A | B | C
  platform          String  @default("douyin") // 三期 IA 演化: platform 字段 — douyin|xiaohongshu|bilibili|x|youtube|gongzhonghao
  stage             String  @default("inbox") // inbox|topic|script|recording|editing|publishing|review|archived
  publicationStatus String  @default("draft") // draft|scheduled|published
  priority          String  @default("normal")
  tags              Json    @default("[]")
  publishedAt       String  @default("") // cockpit 用 ISO date 字符串, 保持原样
  xhsLink           String  @default("")
  coverCopy         String  @default("")
  publishCopy       String  @default("")
  topic             Json // TopicCard
  script            Json // ScriptDraft 骨架
  recordingNotes    String  @default("")
  editingNotes      String  @default("")
  metrics           Json // MetricsSnapshot
  review            Json // Review
  scriptDraftId     String? // → ScriptDraft (AI 稿)
  analysisId        String? // → ContentAnalysis (L1/复盘链)
  createdAt         String
  updatedAt         String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, stage])
  @@index([userId, platform])
  @@index([scriptDraftId])
  @@index([analysisId])
}

model CockpitInspiration {
  id                  String @id
  userId              String
  text                String
  convertedContentIds Json   @default("[]")
  createdAt           String
  updatedAt           String
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CockpitStageEvent {
  id          String @id
  userId      String
  contentId   String
  stage       String
  plannedDate String
  rank        Int
  completedAt String @default("")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, plannedDate])
  @@index([contentId])
}

model CockpitReviewDay {
  id          String @id
  userId      String
  plannedDate String
  note        String @default("")
  createdAt   String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CockpitLiveSession {
  id          String @id
  userId      String
  title       String
  plannedDate String
  startTime   String @default("")
  endTime     String @default("")
  platform    String @default("")
  content     String @default("")
  createdAt   String
  updatedAt   String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CockpitScheduleObjectType {
  id          String  @id
  userId      String
  kind        String // review|live|custom
  name        String
  description String  @default("")
  color       String
  archived    Boolean @default(false)
  createdAt   String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CockpitScheduleObject {
  id          String @id
  userId      String
  typeId      String
  title       String
  plannedDate String
  startTime   String @default("")
  endTime     String @default("")
  details     String @default("")
  createdAt   String
  updatedAt   String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CockpitGoalCycle {
  id               String @id
  userId           String
  objective        String @default("")
  startDate        String
  endDate          String
  status           String @default("active") // active|archived
  outputTarget     Int    @default(0)
  quotas           Json   @default("[]")
  followerStart    Int    @default(0)
  followerTarget   Int    @default(0)
  qualityMetric    String @default("views")
  qualityThreshold Float  @default(0)
  qualityTarget    Int    @default(0)
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model CockpitInsightRule {
  id              String  @id
  userId          String
  text            String
  sourceContentId String?
  active          Boolean @default(true)
  createdAt       String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CockpitPrefs {
  userId          String   @id
  designStyle     String   @default("editorial")
  navigationOrder Json     @default("[]")
  profile         Json // CreatorProfile
  pageTitles      Json // PageTitles
  stageColors     Json // Record<ContentStage,string>
  contentTypes    Json     @default("[]")
  setupComplete   Boolean  @default(false)
  lastBackupAt    String   @default("")
  updatedAt       DateTime @updatedAt // 冲突检测用, 服务端时间
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ 热点雷达 (2026-08-13 四期, spec: docs/superpowers/specs/2026-08-13-radar-deep-collection-design.md) ============
// 设计说明：这里是服务端域数据（雷达抓取/运行结果），不进 cockpit workspace state，因此不沿用 cockpit 的 ISO 字符串日期约定——
// 时间戳一律用 DateTime，id 由服务端 @default(cuid()) 生成（而非客户端传入）。

model RadarKeyword {
  id        String   @id @default(cuid())
  userId    String
  text      String
  status    String   @default("active") // active|candidate|ignored
  source    String   @default("manual") // manual|ai
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, text])
  @@index([userId, status])
}

model RadarItem {
  id              String    @id @default(cuid())
  userId          String
  url             String
  titleHash       String // 标题指纹, 去重用
  title           String
  sourceSite      String
  publishedAt     DateTime?
  collectedAt     DateTime  @default(now())
  matchedKeywords Json      @default("[]")
  aiSummary       String    @default("")
  aiAngle         String    @default("")
  heatScore       Int       @default(0)
  heatFactors     Json      @default("{}") // 四维 + 共现
  status          String    @default("new") // new|adopted|ignored
  inspirationId   String?
  runId           String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
  @@index([userId, status])
  @@index([userId, heatScore])
}

model RadarRun {
  id           String    @id @default(cuid())
  userId       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  keywordsUsed Json      @default("[]")
  searched     Int       @default(0)
  read         Int       @default(0)
  kept         Int       @default(0)
  errors       Json      @default("[]")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RadarConfig {
  userId             String  @id
  tavilyKeyEncrypted String  @default("") // 复用 AIConfig 的 AES-256-GCM 加密
  dailyLimit         Int     @default(20)
  enabled            Boolean @default(false)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ 风格档案 (五期「创作质量深化」Task 1, spec: docs/superpowers/specs/2026-08-13-script-quality-design.md §2) ============
// StyleProfile 是 userId 单行配置，学 RadarConfig 先例：不建 User 反向关系。
// StyleSample 是「定稿即样本」积累路线的沉淀记录，学 ScriptDraft 先例：建 User 关系。

model StyleProfile {
  userId      String   @id
  description String   @default("") // 口吻/句式/口头禅/忌讳
  updatedAt   DateTime @updatedAt
}

model StyleSample {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  platform            String // 本期只有 'douyin'
  content             String // 定稿逐字稿纯文本
  sourceScriptDraftId String? // 溯源
  createdAt           DateTime @default(now())

  @@index([userId, platform, createdAt])
}

// ============ 人设定位驱动选题 (八期, spec: docs/superpowers/specs/2026-08-14-persona-driven-topics-design.md §1) ============
// PersonaProfile 是 userId 单行配置，学 StyleProfile/RadarConfig 先例：不建 User 反向关系。

model PersonaProfile {
  userId      String   @id
  audience    String   @default("") // 目标受众
  targetFans  String   @default("") // 想吸引的粉丝画像
  pillars     Json     @default("[]") // PersonaPillar[]
  angle       String   @default("") // 差异化角度
  avoid       String   @default("") // 忌讳
  updatedAt   DateTime @updatedAt
}
